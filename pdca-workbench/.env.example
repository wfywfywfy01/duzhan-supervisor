# 督战官（开源脱敏版）环境变量示例
# 复制成 .env 后按自己环境填写；服务启动时自动读取（python-dotenv）。

# ── 服务 ──────────────────────────────────────────────
PDCA_ENV=development
TZ=Asia/Shanghai
PDCA_HOST=0.0.0.0
PDCA_WORKBENCH_PORT=8767
# 生产部署时必填：会话/CSRF 签名密钥（>=32 位随机串）
PDCA_SECRET_KEY=
# 浏览器跨源白名单（部署域名）；开发留空
PDCA_CORS_ORIGINS=
PDCA_WORKBENCH_BASE_URL=http://localhost:8767

# ── 数据库 ────────────────────────────────────────────
# 必填；本地可先用 sqlite：sqlite:///./data/duzhan.db
PDCA_DATABASE_URL=postgresql+psycopg2://duzhan:change_me@localhost:5432/duzhan

# ── IM CLI（采集群消息 / 推送群消息的唯一出口）──────────
# 本项目通过命令行工具取数与发消息；换成你自己的实现即可
VERTU_COMMAND=company-cli
VERTU_VPS_SERVICE_URL=https://vps.example.com
VERTU_APP_ID=duzhan
VERTU_APP_KEY=
PDCA_REQUIRE_VERTU=0

# ── 督战官：达标群三追 ────────────────────────────────
# 0=只跑采集不推群；1=按档推群
PDCA_DUZHAN_ENABLED=0
PDCA_DUZHAN_TIMES=10:00,15:00,20:00
# 每档提前多少分钟采集（快照落盘，推送时只读快照）
PDCA_DUZHAN_LEAD_MINUTES=15
# code=用代码里写死的群；db=用配置页里启用的子 Agent
PDCA_DUZHAN_CONFIG_SOURCE=code
# 1=只发精简版；0=发完整版
PDCA_DUZHAN_COMPACT=1
# 群内 @机器人 自动回复
PDCA_DUZHAN_REPLY_ENABLED=0
# 节假日是否照常催（逗号分隔的群 ID）；长假期间默认免罚
PDCA_DUZHAN_STRICT_HOLIDAY_CHANNELS=
# 子 Agent 的 AI 规则（留空则不调用大模型）
PDCA_SUPERVISOR_PROVIDER=
PDCA_SUPERVISOR_MODEL=
PDCA_SUPERVISOR_API_KEY=
PDCA_DUZHAN_AI_DAILY_LIMIT=60

# ── C转B 跟进群 ──────────────────────────────────────
PDCA_CTOB_ENABLED=0
PDCA_CTOB_TIMES=10:00,15:00,20:00

# ── 小黑屋开单祝贺机器人 ──────────────────────────────
PDCA_HEIWU_ENABLED=0
PDCA_HEIWU_POLL_MINUTES=5
PDCA_HEIWU_BOT_APP_ID=
PDCA_HEIWU_BOT_SECRET=
# 群机器人未配置时，退回用督战官机器人身份发
PDCA_DUZHAN_BOT_APP_ID=
PDCA_DUZHAN_BOT_SECRET=

# ── 策略核查（WhatsApp 口径抽查）─────────────────────
PDCA_STRATEGY_WA_BRIEF_ENABLED=0
PDCA_STRATEGY_WA_BRIEF_TIME=08:00
PDCA_STRATEGY_WA_BRIEF_CHANNEL_ID=

# ── 调度与运行目录 ───────────────────────────────────
PDCA_SCHEDULER_ENABLED=1
PDCA_DATA_DIR=./data
PDCA_LOG_LEVEL=INFO
